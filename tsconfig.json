{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "strict": true,
    "module": "none",
    "noImplicitAny": true,
    "outFile": "./build/build.js",
    "preserveConstEnums": true,
    "removeComments": true,
    "rootDir": "./sketch/",
    "sourceMap": true,
    "target": "es5",
    "moduleResolution": "node",
    "lib": [
      "ES2025",
      "DOM",
    ],
  }
}